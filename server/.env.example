# Домен сервера, например morsegram.skvishik.fun. С него же уходят письма: noreply@ДОМЕН
DOMAIN=

# Пароль базы данных: длинная случайная строка. Сгенерировать: openssl rand -hex 24
DATABASE_PASSWORD=

# Письма с кодами по умолчанию отправляет свой почтовый сервер (сервис mail).
# Чтобы вместо него слать через внешний SMTP (например, Gmail), раскомментируй и заполни:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=
