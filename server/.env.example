# Домен сервера, например morsegram.duckdns.org
DOMAIN=

# Пароль базы данных: длинная случайная строка. Сгенерировать: openssl rand -hex 24
DATABASE_PASSWORD=

# Почта для писем с кодом. Для Gmail: smtp.gmail.com, порт 587,
# логин — адрес почты, пароль — «пароль приложения» из настроек Google-аккаунта.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
